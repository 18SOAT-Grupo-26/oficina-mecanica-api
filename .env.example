# =============================================================================================
# Oficina Mecânica API — variáveis de ambiente
# Copie para .env (não versionado: está no .gitignore) e ajuste os valores.
# O docker-compose.yml lê este arquivo; rodando pela IDE, a API também lê
# (spring.config.import: optional:file:.env[.properties] no application.yaml).
# Linhas comentadas (#) já têm valor padrão: descomente só para mudar.
# =============================================================================================

# ---- Aplicação -------------------------------------------------------------------------------
# Porta HTTP da API. Se mudar, ajuste também o "ports" e o healthcheck da api no docker-compose.yml
# e os targets em prometheus/prometheus.yaml.
# SERVER_PORT=8081
# Prefixo das rotas (context-path). Se mudar, ajuste o healthcheck da api e o metrics_path
# em prometheus/prometheus.yaml.
# APPLICATION_PREFIX=api/v1
# APPLICATION_NAME=oficina-mecanica-api
# Nível de log do pacote da aplicação: TRACE, DEBUG, INFO, WARN ou ERROR
LOG_LEVEL=INFO
# LOG_PATH=/tmp/logs

# ---- Segurança -------------------------------------------------------------------------------
# Segredo do JWT (HS512: no mínimo 64 bytes). Vazio = a API gera uma chave aleatória a cada subida (só para uso
# local: os tokens deixam de valer a cada reinício). Fora do ambiente local, gere a sua: openssl rand -base64 64
API_SECRET=
# Validade do token de login, em minutos
# JWT_EXPIRATION_MINUTES=60
# Origens do front que podem chamar a API pelo navegador, separadas por vírgula (vazio = nenhuma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Administrador inicial -------------------------------------------------------------------
# Criado na subida se ainda não existir nenhum ADMIN. Com e-mail, usuário ou senha vazios, não é criado.
# A senha segue a política: 8 a 64 caracteres, com maiúscula, minúscula, número e caractere especial.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_USUARIO=
ADMIN_SENHA=

# ---- Banco de dados (PostgreSQL) -------------------------------------------------------------
# Usuário e senha do container db; a API (no Docker e na IDE) usa os mesmos.
# O PostgreSQL só os aplica ao criar o volume: depois de mudar, rode docker compose down -v (apaga os dados).
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres
# URL JDBC usada fora do Docker (no Docker, o compose aponta para o serviço db)
# DATASOURCE_HOST=jdbc:postgresql://localhost:5432/oficina
# Porta do banco na sua máquina. Troque se já houver um PostgreSQL instalado na 5432
# e ajuste a porta em DATASOURCE_HOST junto.
# DB_HOST_PORT=5432
# Pool de conexões e tempos limite: passou do limite, a API responde 503 em vez de travar
# DATASOURCE_POOL_SIZE=10
# DATASOURCE_CONNECTION_TIMEOUT_MS=5000
# DATASOURCE_QUERY_TIMEOUT_MS=5000

# ---- Observabilidade (Grafana) ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
