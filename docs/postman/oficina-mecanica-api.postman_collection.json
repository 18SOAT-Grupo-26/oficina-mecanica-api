  "item": [
    {
      "name": "Auth",
      "description": "Cadastro, login e validação do token. Rotas públicas (`/auth/**`).",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "description": "Cadastra identidade, contato, endereço e usuário numa transação só. O perfil (`perfil`) deve existir: `ADMINISTRATOR`, `MANAGER` ou `OPERATOR`. O script gera username, e-mail e CPF únicos e guarda as credenciais para o login.\n\nSenha: 8 a 64 caracteres, com maiúscula, minúscula, número e caractere especial.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identidade\": {\n    \"nomeCompleto\": \"Administrador da Oficina\",\n    \"primeiroNome\": \"Admin\",\n    \"documento\": \"{{cpfGerado}}\",\n    \"rg\": \"123456789\",\n    \"dataNascimento\": \"1990-05-20\",\n    \"contato\": {\n      \"telefone\": \"11987654321\",\n      \"email\": \"{{username}}@oficina.com\"\n    },\n    \"endereco\": {\n      \"logradouro\": \"Rua das Oficinas\",\n      \"numero\": \"100\",\n      \"bairro\": \"Centro\",\n      \"cidade\": \"São Paulo\",\n      \"estado\": \"SP\",\n      \"cep\": \"01001000\",\n      \"complemento\": \"Galpão 2\"\n    }\n  },\n  \"usuario\": {\n    \"nomeUsuario\": \"{{username}}\",\n    \"senha\": \"{{password}}\",\n    \"trocaSenhaObrigatoria\": false,\n    \"perfil\": \"ADMINISTRATOR\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"username\", \"admin_\" + pm.variables.get(\"sufixo\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Gera o token JWT. `identificador` aceita nome de usuário ou e-mail. O script guarda o token em `{{token}}`, usado pelas demais pastas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"{{username}}\",\n  \"senha\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const token = pm.response.json().token || \"\";",
                  "pm.collectionVariables.set(\"token\", token.replace(/^Bearer\\s+/, \"\"));",
                  "pm.test(\"Token recebido\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"token\")).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "validate"
              ]
            },
            "description": "Retorna `true` se o token enviado no header `Authorization` for válido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
